# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=llm_observatory
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/llm_observatory

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Encryption (AES-256-CBC) ──────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Authentication (single user — no public registration) ─────────────────────
AUTH_EMAIL=admin@example.com
# Genera el hash con: node scripts/generate-password-hash.js tupassword
AUTH_PASSWORD_HASH=
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Alerts (opcional) ─────────────────────────────────────────────────────────
# URL del webhook de Discord para notificaciones de alertas
DISCORD_WEBHOOK_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Obtén tu API key en: https://resend.com/api-keys
# En sandbox puedes usar onboarding@resend.dev como EMAIL_FROM sin verificar dominio
RESEND_API_KEY=
EMAIL_FROM=noreply@tudominio.com
# URL pública del frontend — se usa en los links de los emails
APP_URL=http://localhost:5173

# ── Seguridad ─────────────────────────────────────────────────────────────────
# CORS: en producción, pon el dominio exacto del frontend (ej. https://observatory.tudominio.com)
# En desarrollo: dejar vacío o usar * para permitir cualquier origen
CORS_ORIGIN=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# En Docker: dejar vacío (nginx actúa como proxy)
# En desarrollo local: http://localhost:3001
VITE_API_URL=http://localhost:3001
